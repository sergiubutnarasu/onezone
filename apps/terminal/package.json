{
  "name": "@onezone/terminal",
  "version": "0.0.1",
  "private": true,
  "description": "Onezone Terminal CLI",
  "type": "module",
  "bin": {
    "onezone-terminal": "./bin/run.js"
  },
  "oclif": {
    "bin": "onezone-terminal",
    "dirname": "onezone-terminal",
    "commands": "./dist/commands",
    "topicSeparator": " "
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm ./bin/dev.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oclif/core": "^4.0.27",
    "@onezone/shared": "workspace:*",
    "socket.io-client": "^4.8.0"

  },
  "devDependencies": {
    "@onezone/tsconfig": "workspace:*",
    "@types/node": "^22.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}

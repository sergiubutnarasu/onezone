{
  "name": "@onezone/terminal",
  "version": "0.0.17",
  "publishConfig": {
    "access": "public"
  },
  "description": "Onezone Terminal CLI",
  "type": "module",
  "bin": {
    "onezone-terminal": "./bin/run.js"
  },
  "files": [
    "dist",
    "bin",
    ".oclif.manifest.json"
  ],
  "oclif": {
    "bin": "onezone-terminal",
    "dirname": "onezone-terminal",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands",
      "globPatterns": [
        "**/*.js"
      ]
    },
    "topicSeparator": " "
  },
  "scripts": {
    "build": "tsc && rm -rf dist/static && cp -r src/static dist/static && oclif manifest",
    "dev": "node --loader ts-node/esm ./bin/dev.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@oclif/core": "^4.0.27",
    "@onezone/shared": "workspace:*",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@onezone/tsconfig": "workspace:*",
    "@types/node": "^22.5.0",
    "oclif": "^4.23.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}

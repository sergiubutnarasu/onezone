    "listen": {
      "aliases": [],
      "args": {},
      "description": "Starts a terminal instance that listens for task assignments and executes commands accordingly. The terminal will automatically execute commands for tasks assigned to it, based on the task's status. Use this command to keep a terminal instance running in the background, ready to handle incoming tasks.",
      "examples": [
        "<%= config.bin %> listen",
        "<%= config.bin %> listen --name my-terminal"
      ],
      "flags": {
        "server": {
          "description": "Server URL",
          "name": "server",
          "default": "http://localhost:5026",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "name": {
          "description": "Terminal name — must be unique across all running terminals",
          "name": "name",
          "default": "MacBookPro",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
      "id": "listen",
      "pluginAlias": "@onezone/terminal",
      "pluginName": "@onezone/terminal",
      "pluginType": "core",
      "strict": true,
      "enableJsonFlag": false,
      "isESM": true,
      "relativePath": [
        "dist",
        "commands",
        "listen.js"
      ]
    },

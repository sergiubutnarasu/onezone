generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageType {
  CHAT
  COMMAND_START
  COMMAND_EXIT
}

enum NotificationType {
  TASK_COMPLETED
  COMMAND_START
  COMMAND_EXIT_SUCCESS
  COMMAND_EXIT_FAILURE
}

model Agent {
  id            String         @id @default(uuid())
  name          String         @unique
  tag           String
  model         String
  createdAt     DateTime       @default(now())
  projects      Project[]
  tasks         Task[]
  kanbanColumns KanbanColumn[]
  messages      Message[]

  @@map("agents")
}

model Project {
  id             String         @id @default(uuid())
  name           String
  description    String?
  repository     String?
  defaultAgentId String
  defaultAgent   Agent          @relation(fields: [defaultAgentId], references: [id], onDelete: Restrict)
  defaultModel   String
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  tasks          Task[]
  skills         ProjectSkill[]
  kanbanColumns  KanbanColumn[]
  notifications  Notification[]

  @@index([userId])
  @@map("projects")
}

model KanbanColumn {
  id              String       @id @default(uuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  instructions    String       @default("")
  index           Int          @default(0)
  agentId         String?
  agent           Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  model           String?
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())
  taskAssignments TaskColumn[]

  @@index([projectId])
  @@index([index])
  @@index([userId])
  @@map("kanban_columns")
}

model ProjectSkill {
  id          String   @id @default(uuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      String
  skillName   String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  installedAt DateTime @default(now())

  @@unique([projectId, skillName])
  @@index([projectId])
  @@index([userId])
  @@map("project_skills")
}

model Task {
  id                   String        @id @default(uuid())
  projectId            String
  project              Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  order                Int           @default(0)
  agentId              String
  agent                Agent         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  model                String
  useTaskAgentAndModel Boolean       @default(false)
  completedAt          DateTime?
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt            DateTime      @default(now())
  messages             Message[]
  terminalAssignment   TaskTerminal?
  columnAssignment     TaskColumn?
  notifications        Notification[]

  @@index([projectId])
  @@index([userId])
  @@map("tasks")
}

model TaskColumn {
  taskId     String       @id
  columnId   String
  task       Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  column     KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignedAt DateTime     @default(now())

  @@index([columnId])
  @@map("task_columns")
}

model TaskTerminal {
  taskId     String   @id
  terminalId String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@index([terminalId])
  @@map("task_terminals")
}

model Message {
  id          String   @id @default(uuid())
  roomId      String
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  role        String
  terminalId  String?
  terminalName String?
  messageType MessageType
  jobId        String?
  command      String?
  exitCode     Int?
  stream       String?
  content      String   @db.Text
  agentId      String?
  agent        Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  model        String?
  inputTokens  Int?
  outputTokens Int?
  totalCostUsd Float?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  ts           BigInt
  createdAt    DateTime @default(now())

  @@index([roomId])
  @@index([taskId])
  @@index([ts])
  @@index([userId])
  @@map("messages")
}

model Terminal {
  id              String         @id
  name            String         @unique
  hostname        String
  isConnected     Boolean        @default(false)
  lastSeenAt      DateTime?
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  taskAssignments TaskTerminal[]

  @@index([userId])
  @@map("terminals")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  taskId    String
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([readAt])
  @@index([createdAt])
  @@index([taskId])
  @@index([projectId])
  @@map("notifications")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  deviceCodes   DeviceCode[]
  projects      Project[]
  tasks         Task[]
  kanbanColumns KanbanColumn[]
  skills        ProjectSkill[]
  terminals     Terminal[]
  messages      Message[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model DeviceCode {
  id            String   @id @default(uuid())
  deviceCode    String   @unique
  userCode      String   @unique
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  approved      Boolean  @default(false)
  expiresAt     DateTime
  lastPolledAt  DateTime?
  createdAt     DateTime @default(now())

  @@index([userCode])
  @@map("device_codes")
}

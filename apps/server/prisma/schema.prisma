generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageType {
  CHAT
  COMMAND_START
  COMMAND_EXIT
}

model Agent {
  id          String   @id @default(uuid())
  name        String   @unique
  tag         String
  model       String
  createdAt   DateTime @default(now())
  projects    Project[]
  tasks       Task[]

  @@map("agents")
}

model Project {
  id             String         @id @default(uuid())
  name           String
  description    String?
  repository     String?
  defaultAgentId String
  defaultAgent   Agent          @relation(fields: [defaultAgentId], references: [id], onDelete: Restrict)
  defaultModel   String
  createdAt      DateTime       @default(now())
  tasks          Task[]
  skills         ProjectSkill[]
  kanbanColumns  KanbanColumn[]

  @@map("projects")
}

model KanbanColumn {
  id              String       @id @default(uuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  instructions    String?
  index           Int          @default(0)
  createdAt       DateTime     @default(now())
  taskAssignments TaskColumn[]

  @@index([projectId])
  @@index([index])
  @@map("kanban_columns")
}

model ProjectSkill {
  id          String   @id @default(uuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      String
  skillName   String
  installedAt DateTime @default(now())

  @@unique([projectId, skillName])
  @@index([projectId])
  @@map("project_skills")
}

model Task {
  id                 String        @id @default(uuid())
  projectId          String
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  order              Int           @default(0)
  agentId            String
  agent              Agent         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  model              String
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  messages           Message[]
  terminalAssignment TaskTerminal?
  columnAssignment   TaskColumn?

  @@index([projectId])
  @@map("tasks")
}

model TaskColumn {
  taskId     String       @id
  columnId   String
  task       Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  column     KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignedAt DateTime     @default(now())

  @@index([columnId])
  @@map("task_columns")
}

model TaskTerminal {
  taskId     String   @id
  terminalId String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@index([terminalId])
  @@map("task_terminals")
}

model Message {
  id          String   @id @default(uuid())
  roomId      String
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  role        String
  terminalId  String?
  terminalName String?
  messageType MessageType
  jobId        String?
  command      String?
  exitCode     Int?
  stream       String?
  content      String   @db.Text
  inputTokens  Int?
  outputTokens Int?
  totalCostUsd Float?
  ts           BigInt
  createdAt    DateTime @default(now())

  @@index([roomId])
  @@index([taskId])
  @@index([ts])
  @@map("messages")
}

model Terminal {
  id              String         @id
  name            String         @unique
  hostname        String
  isConnected     Boolean        @default(false)
  lastSeenAt      DateTime?
  createdAt       DateTime       @default(now())
  taskAssignments TaskTerminal[]

  @@map("terminals")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageType {
  CHAT
  COMMAND_START
  COMMAND_EXIT
}

enum TaskStatus {
  BACKLOG
  PLANNING
  IN_PROGRESS
  IN_REVIEW
  TESTING
  DONE
}

model Agent {
  id          String   @id @default(uuid())
  name        String   @unique
  tag         String
  model       String
  createdAt   DateTime @default(now())
  projects    Project[]
  tasks       Task[]

  @@map("agents")
}

model Project {
  id             String   @id @default(uuid())
  name           String
  description    String?
  repository     String?
  defaultAgentId String
  defaultAgent   Agent    @relation(fields: [defaultAgentId], references: [id], onDelete: Restrict)
  defaultModel   String
  createdAt      DateTime @default(now())
  tasks          Task[]

  @@map("projects")
}

model Task {
  id                 String       @id @default(uuid())
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  status             TaskStatus   @default(BACKLOG)
  order              Int          @default(0)
  agentId            String
  agent              Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  model              String
  createdAt          DateTime     @default(now())
  messages           Message[]
  terminalAssignment TaskTerminal?

  @@index([projectId])
  @@map("tasks")
}

model TaskTerminal {
  taskId     String   @id
  terminalId String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@index([terminalId])
  @@map("task_terminals")
}

model Message {
  id          String   @id @default(uuid())
  roomId      String
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  role        String
  terminalId  String?
  terminalName String?
  messageType MessageType
  jobId        String?
  command      String?
  exitCode     Int?
  stream       String?
  content      String   @db.Text
  inputTokens  Int?
  outputTokens Int?
  totalCostUsd Float?
  ts           BigInt
  createdAt    DateTime @default(now())

  @@index([roomId])
  @@index([taskId])
  @@index([ts])
  @@map("messages")
}

model Terminal {
  id              String         @id
  name            String         @unique
  hostname        String
  isConnected     Boolean        @default(false)
  lastSeenAt      DateTime?
  createdAt       DateTime       @default(now())
  taskAssignments TaskTerminal[]

  @@map("terminals")
}
